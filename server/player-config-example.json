{
  "mode": "proxy",
  "proxy": {
    "listen": "0.0.0.0:28090",
    "upstream": "http://127.0.0.1:28080",
    "matchServer": "http://YOUR_SERVER_IP:28090",
    "matchPort": 28090,
    "stun": {
      "host": "match",
      "port": 3478
    },
    "logTraffic": true,
    "turn": {
      "host": "auto"
    }
  }
}
